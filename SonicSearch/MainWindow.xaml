<Window x:Class="SonicSearch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SonicSearch"
        Title="SonicSearch" SizeToContent="Height" Width="750"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Window.Resources>
        <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="#1E1E22"/>
        <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="#3E3E46"/>
        <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="#50505A"/>
        <SolidColorBrush x:Key="ScrollBarThumbDraggingBrush" Color="#646472"/>

        <Style x:Key="ModernScrollThumb" TargetType="{x:Type Thumb}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border Background="{StaticResource ScrollBarThumbBrush}" CornerRadius="6" Margin="2,0,2,0"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource ScrollBarThumbHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter Property="Background" Value="{StaticResource ScrollBarThumbDraggingBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Width" Value="14"/>
            <Setter Property="MinWidth" Value="14"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ModernScrollThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Search box "3D" styling: a recessed gradient field, a soft ambient shadow at rest,
             and a blue focus glow, so it reads as a raised/inset control rather than a flat rectangle. -->
        <LinearGradientBrush x:Key="SearchBoxBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#2A2A2E" Offset="0"/>
            <GradientStop Color="#222225" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="SearchBoxBackgroundHoverBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#2E2E33" Offset="0"/>
            <GradientStop Color="#26262A" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="SearchBoxBorderBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#3D3D46" Offset="0"/>
            <GradientStop Color="#19191C" Offset="1"/>
        </LinearGradientBrush>
        <DropShadowEffect x:Key="SearchBoxIdleShadow" Color="Black" BlurRadius="10" ShadowDepth="2" Direction="270" Opacity="0.45"/>
        <DropShadowEffect x:Key="SearchBoxFocusGlow" Color="#3B82F6" BlurRadius="22" ShadowDepth="0" Opacity="0.6"/>

        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#252528"/>
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="BorderBrush" Value="#44444C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="2" Opacity="0.5"/>
                            </Border.Effect>
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    
    <Border Background="#EE1C1C1F" CornerRadius="12" Margin="30">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="0" Opacity="0.6"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <Grid Grid.Row="0" Margin="25,25,25,10">
                <TextBox x:Name="txtSearch" Margin="0"
                         Foreground="White" BorderThickness="1"
                         CaretBrush="#60A5FA" SelectionBrush="#3B82F6"
                         FontSize="26" Padding="18,10,110,10"
                         TextWrapping="Wrap" AcceptsReturn="False"
                         MaxHeight="170" VerticalScrollBarVisibility="Auto"
                         VerticalContentAlignment="Center"
                         TextChanged="txtSearch_TextChanged"
                         PreviewKeyDown="txtSearch_PreviewKeyDown"
                         GotFocus="txtSearch_GotFocus">
                    <TextBox.Template>
                        <ControlTemplate TargetType="TextBox">
                            <Grid>
                                <Border x:Name="border" CornerRadius="10"
                                        Background="{StaticResource SearchBoxBackgroundBrush}"
                                        BorderBrush="{StaticResource SearchBoxBorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        Effect="{StaticResource SearchBoxIdleShadow}"/>
                                <!-- glassy top highlight for a subtle 3D edge -->
                                <Border CornerRadius="10,10,0,0" Height="1" VerticalAlignment="Top"
                                        Margin="1,1,1,0" Background="#18FFFFFF" IsHitTestVisible="False"/>
                                <ScrollViewer x:Name="PART_ContentHost" Margin="0"
                                              Padding="{TemplateBinding Padding}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="{StaticResource SearchBoxBackgroundHoverBrush}"/>
                                </Trigger>
                                <Trigger Property="IsFocused" Value="True">
                                    <Setter TargetName="border" Property="BorderBrush" Value="#60A5FA"/>
                                    <Setter TargetName="border" Property="Effect" Value="{StaticResource SearchBoxFocusGlow}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </TextBox.Template>
                </TextBox>

                <Popup x:Name="popupSuggestions" PlacementTarget="{Binding ElementName=txtSearch}"
                       Placement="Bottom" VerticalOffset="4" AllowsTransparency="True"
                       Focusable="False" StaysOpen="False" IsOpen="False">
                    <Border Background="#1E1E22" BorderBrush="#3F3F46" BorderThickness="1"
                            CornerRadius="8" MinWidth="480" MaxWidth="700" MaxHeight="260" Padding="4">
                        <Border.Effect>
                            <DropShadowEffect Color="Black" BlurRadius="16" ShadowDepth="4" Opacity="0.7"/>
                        </Border.Effect>
                        <ListBox x:Name="lstSuggestions" Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 PreviewMouseDown="lstSuggestions_PreviewMouseDown">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="bd" Background="Transparent" CornerRadius="6" Padding="8,6" Margin="1,1">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="#3F3F46"/>
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="#2D2D30"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="2,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <!-- Badge / Tag -->
                                        <Border Grid.Column="0" Background="#2A2A30" CornerRadius="4" Padding="6,2" Margin="0,0,10,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding IconKind}" Foreground="#FACC15" FontSize="11" FontWeight="Bold"/>
                                        </Border>
                                        
                                        <!-- Title -->
                                        <TextBlock Grid.Column="1" Text="{Binding Title}" Foreground="#EEEEEE" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        
                                        <!-- Description -->
                                        <TextBlock Grid.Column="2" Text="{Binding Description}" Foreground="#808088" FontSize="12" VerticalAlignment="Center" Margin="12,0,10,0"/>

                                        <!-- Tab Helper Key Badge -->
                                        <Border Grid.Column="3" Background="#26262B" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="4" Padding="5,1" VerticalAlignment="Center">
                                            <TextBlock Text="Tab" Foreground="#A1A1AA" FontSize="10" FontWeight="SemiBold"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Popup>
                
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
                    <Button x:Name="btnClear" Click="ClearButton_Click" Width="30" Height="30" Margin="0,0,4,0"
                            Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Clear search" Visibility="Collapsed">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bdr" Background="{TemplateBinding Background}" CornerRadius="6">
                                                <Path x:Name="iconPath" Width="14" Height="14" Stretch="Uniform" Fill="#8E8E93"
                                                      Data="M16.24,3.56l4.95,4.94c0.78,0.79 0.78,2.05 0,2.84L15,17.5H19v2H7.21l-3.92,-3.93c-0.78,-0.78 -0.78,-2.05 0,-2.83l9.19,-9.18c0.79,-0.78 2.05,-0.78 2.84,0l0.92,0zm-2.83,2.83l-7.78,7.78 3.54,3.53 7.78,-7.77 -3.54,-3.54z"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bdr" Property="Background" Value="#3F3F46"/>
                                                    <Setter TargetName="iconPath" Property="Fill" Value="#FFFFFF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Click="SettingsButton_Click" Width="30" Height="30" Margin="0,0,4,0"
                            Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Settings">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bdr" Background="{TemplateBinding Background}" CornerRadius="6">
                                                <Path x:Name="iconPath" Width="15" Height="15" Stretch="Uniform" Fill="#8E8E93"
                                                      Data="M19.14,12.94c0.04,-0.3 0.06,-0.61 0.06,-0.94c0,-0.32 -0.02,-0.64 -0.07,-0.94l2.03,-1.58c0.18,-0.14 0.23,-0.41 0.12,-0.61l-1.92,-3.32c-0.12,-0.22 -0.37,-0.29 -0.59,-0.22l-2.39,0.96c-0.5,-0.38 -1.03,-0.7 -1.62,-0.94l-0.36,-2.54c-0.04,-0.24 -0.24,-0.41 -0.48,-0.41h-3.84c-0.24,0 -0.43,0.17 -0.47,0.41l-0.36,2.54c-0.59,0.24 -1.13,0.57 -1.62,0.94l-2.39,-0.96c-0.22,-0.08 -0.47,0 -0.59,0.22L2.74,8.87c-0.12,0.21 -0.08,0.47 0.12,0.61l2.03,1.58c-0.05,0.3 -0.09,0.63 -0.09,0.94s0.02,0.64 0.07,0.94l-2.03,1.58c-0.18,0.14 -0.23,0.41 -0.12,0.61l1.92,3.32c0.12,0.22 0.37,0.29 0.59,0.22l2.39,-0.96c0.5,0.38 1.03,0.7 1.62,0.94l0.36,2.54c0.05,0.24 0.24,0.41 0.48,0.41h3.84c0.24,0 0.44,-0.17 0.47,-0.41l0.36,-2.54c0.59,-0.24 1.13,-0.56 1.62,-0.94l2.39,0.96c0.22,0.08 0.47,0 0.59,-0.22l1.92,-3.32c0.12,-0.22 0.07,-0.47 -0.12,-0.61l-2.01,-1.58zM12,15.6c-1.98,0 -3.6,-1.62 -3.6,-3.6s1.62,-3.6 3.6,-3.6s3.6,1.62 3.6,3.6s-1.62,3.6 -3.6,3.6z"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bdr" Property="Background" Value="#3F3F46"/>
                                                    <Setter TargetName="iconPath" Property="Fill" Value="#FFFFFF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Click="CloseButton_Click" Width="30" Height="30"
                            Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Close">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bdr" Background="{TemplateBinding Background}" CornerRadius="6">
                                                <Path x:Name="iconPath" Width="10" Height="10" Stretch="Uniform" Stroke="#8E8E93" StrokeThickness="1.8"
                                                      Data="M1,1 L9,9 M9,1 L1,9"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bdr" Property="Background" Value="#E81123"/>
                                                    <Setter TargetName="iconPath" Property="Stroke" Value="#FFFFFF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
            
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="32,0,30,14" VerticalAlignment="Center">
                <TextBlock x:Name="lblStatusDot" Text="●" Foreground="#10B981" FontSize="10" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock x:Name="lblStatus" Foreground="#10B981" FontSize="13" FontWeight="SemiBold" Text="Ready"/>
            </StackPanel>
            
            <Grid x:Name="resultsGrid" Grid.Row="2" Margin="25,0,25,20" Height="350" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="280"/>
                </Grid.ColumnDefinitions>
                
                <ListView x:Name="listView" Grid.Column="0" 
                          Background="Transparent" BorderThickness="0" Foreground="White"
                          VirtualizingStackPanel.IsVirtualizing="True" 
                          VirtualizingStackPanel.VirtualizationMode="Recycling"
                          VirtualizingStackPanel.ScrollUnit="Pixel"
                          VirtualizingStackPanel.CacheLength="20,20"
                          VirtualizingStackPanel.CacheLengthUnit="Item"
                          SelectionChanged="listView_SelectionChanged"
                          MouseDoubleClick="listView_MouseDoubleClick"
                          KeyDown="listView_KeyDown"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,3,4,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Image Grid.Column="0" Source="{Binding Icon}" Width="20" Height="20" Margin="0,2,8,2" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock local:HighlightHelper.Text="{Binding DisplayName}"
                                               local:HighlightHelper.SearchText="{Binding Text, ElementName=txtSearch}"
                                               FontSize="15" FontWeight="SemiBold" Foreground="#EEEEEE" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock local:HighlightHelper.Text="{Binding DirectoryName}"
                                               local:HighlightHelper.SearchText="{Binding Text, ElementName=txtSearch}"
                                               FontSize="12" Foreground="#808088" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="4,4">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#3F3F46"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#2D2D30"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>
                
                <Border Grid.Column="1" Background="#252526" CornerRadius="10" Margin="15,0,0,0" Padding="20">
                    <StackPanel x:Name="previewPanel" Visibility="Hidden">
                        <Image x:Name="picPreviewIcon" Width="64" Height="64" Margin="0,10,0,20" HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock x:Name="lblPreviewName" FontSize="18" FontWeight="Bold" TextWrapping="Wrap" Foreground="White" TextAlignment="Center"/>
                        <TextBlock x:Name="lblPreviewDetails" FontSize="13" Foreground="#AAAAAA" TextWrapping="Wrap" Margin="0,25,0,25" LineHeight="20"/>
                        <Button x:Name="btnOpenFile" Content="Open File" Click="btnOpenFile_Click" 
                                Background="#3F3F46" Foreground="White" BorderThickness="0" Padding="12,8" Margin="0,0,0,12" FontSize="14">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                        <Button x:Name="btnOpenFolder" Content="Show in Folder" Click="btnOpenFolder_Click" 
                                Background="#3F3F46" Foreground="White" BorderThickness="0" Padding="12,8" FontSize="14">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>