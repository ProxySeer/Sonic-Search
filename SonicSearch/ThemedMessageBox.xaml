<Window x:Class="SonicSearch.ThemedMessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SonicSearch" SizeToContent="WidthAndHeight" MinWidth="360" MaxWidth="480"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        MouseLeftButtonDown="Window_MouseLeftButtonDown" KeyDown="Window_KeyDown"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Border Background="#EE1C1C1F" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="12" Margin="18">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="24" ShadowDepth="0" Opacity="0.65"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Grid Grid.Row="0" Height="38">
                <TextBlock x:Name="txtTitle" Text="SonicSearch" Foreground="#A1A1AA" FontSize="12" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="16,0,0,0"/>
                <Button x:Name="btnClose" Content="✕" Click="BtnClose_Click"
                        Width="30" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"
                        Background="Transparent" BorderThickness="0" Foreground="#A1A1AA" FontSize="12" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#E4374B"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- Body: icon + message -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="20,4,20,20" VerticalAlignment="Top">
                <Border x:Name="iconBadge" Width="38" Height="38" CornerRadius="19" VerticalAlignment="Top" Margin="0,0,14,0">
                    <TextBlock x:Name="txtIconGlyph" Text="!" FontSize="18" FontWeight="Bold" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock x:Name="txtMessage" Text="Message" Foreground="#E4E4E7" FontSize="13.5"
                           TextWrapping="Wrap" MaxWidth="360" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Buttons -->
            <StackPanel x:Name="buttonPanel" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                        Margin="20,0,20,18"/>
        </Grid>
    </Border>
</Window>
